{
  "$schema": "vscode://schemas/color-theme",
  "name": "Leuven",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#335EA8",
    "foreground": "#333333",
    "selection.background": "#8ED3FF",
    "textLink.foreground": "#006DAF",
    "textLink.activeForeground": "#335EA8",

    "editor.background": "#FFFFFF",
    "editor.foreground": "#333333",
    "editorCursor.foreground": "#21BDFF",
    "editor.selectionBackground": "#8ED3FF",
    "editor.inactiveSelectionBackground": "#8ED3FF80",
    "editor.selectionHighlightBackground": "#B6D6FD80",
    "editor.wordHighlightBackground": "#E4E4E3",
    "editor.wordHighlightStrongBackground": "#B6D6FD",
    "editor.lineHighlightBackground": "#F6FECD",
    "editor.lineHighlightBorder": "#F6FECD",
    "editor.findMatchBackground": "#5974AB80",
    "editor.findMatchBorder": "#5974AB",
    "editor.findMatchHighlightBackground": "#FFFF0099",
    "editor.rangeHighlightBackground": "#FFFFD2",
    "editorBracketMatch.background": "#C0E8C3",
    "editorBracketMatch.border": "#C0E8C3",
    "editorLink.activeForeground": "#006DAF",
    "editorWhitespace.foreground": "#D2D2D2",
    "editorIndentGuide.background1": "#E8E8E8",
    "editorIndentGuide.activeBackground1": "#A7A7A7",
    "editorRuler.foreground": "#E4E4E3",
    "editorLineNumber.foreground": "#9A9A9A",
    "editorLineNumber.activeForeground": "#333333",
    "editorGutter.background": "#EDEDED",
    "editorGutter.addedBackground": "#008000",
    "editorGutter.modifiedBackground": "#006FE0",
    "editorGutter.deletedBackground": "#D0372D",
    "editorError.foreground": "#FF0000",
    "editorWarning.foreground": "#EA6300",
    "editorInfo.foreground": "#006FE0",
    "editorHoverWidget.background": "#FFFFE0",
    "editorHoverWidget.border": "#A7A7A7",
    "editorSuggestWidget.selectedBackground": "#8ED3FF",
    "editorWidget.background": "#F0F0F0",

    "diffEditor.insertedLineBackground": "#DDFFDD",
    "diffEditor.insertedTextBackground": "#97F29580",
    "diffEditor.removedLineBackground": "#FEE8E9",
    "diffEditor.removedTextBackground": "#FFB6BA80",

    "titleBar.activeBackground": "#F0F0F0",
    "titleBar.activeForeground": "#333333",
    "titleBar.inactiveBackground": "#F0F0F0",
    "titleBar.inactiveForeground": "#7F7F7F",
    "activityBar.background": "#E4E4E3",
    "activityBar.foreground": "#333333",
    "activityBar.inactiveForeground": "#7F7F7F",
    "activityBar.activeBorder": "#335EA8",
    "activityBarBadge.background": "#335EA8",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#F7F7F7",
    "sideBar.foreground": "#333333",
    "sideBar.border": "#E4E4E3",
    "sideBarTitle.foreground": "#333333",
    "sideBarSectionHeader.background": "#F0F0F0",
    "sideBarSectionHeader.foreground": "#333333",
    "list.activeSelectionBackground": "#8ED3FF",
    "list.activeSelectionForeground": "#333333",
    "list.inactiveSelectionBackground": "#E4E4E3",
    "list.hoverBackground": "#F6FECD",
    "list.focusOutline": "#335EA8",
    "list.highlightForeground": "#0000FF",

    "editorGroupHeader.tabsBackground": "#F0F0F0",
    "tab.activeBackground": "#FFFFFF",
    "tab.activeForeground": "#333333",
    "tab.activeBorderTop": "#335EA8",
    "tab.inactiveBackground": "#F0F0F0",
    "tab.inactiveForeground": "#7F7F7F",
    "tab.border": "#E4E4E3",
    "breadcrumb.foreground": "#7F7F7F",
    "breadcrumb.focusForeground": "#333333",

    "statusBar.background": "#335EA8",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.border": "#1A2F54",
    "statusBar.noFolderBackground": "#9B9C97",
    "statusBar.debuggingBackground": "#EA6300",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBarItem.hoverBackground": "#1A2F54",
    "statusBarItem.remoteBackground": "#1A2F54",
    "statusBarItem.remoteForeground": "#FFFFFF",

    "panel.background": "#FFFFFF",
    "panel.border": "#E4E4E3",
    "panelTitle.activeBorder": "#335EA8",
    "panelTitle.activeForeground": "#333333",
    "panelTitle.inactiveForeground": "#7F7F7F",

    "button.background": "#335EA8",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#1A2F54",
    "badge.background": "#335EA8",
    "badge.foreground": "#FFFFFF",
    "input.background": "#FFFFFF",
    "input.border": "#A7A7A7",
    "inputOption.activeBorder": "#335EA8",
    "quickInputTitle.background": "#FFD700",
    "pickerGroup.foreground": "#335EA8",
    "progressBar.background": "#21BDFF",

    "gitDecoration.addedResourceForeground": "#008000",
    "gitDecoration.untrackedResourceForeground": "#008000",
    "gitDecoration.modifiedResourceForeground": "#006FE0",
    "gitDecoration.deletedResourceForeground": "#D0372D",
    "gitDecoration.ignoredResourceForeground": "#A9A9A9",
    "gitDecoration.conflictingResourceForeground": "#EA6300",

    "terminal.background": "#FFFFFF",
    "terminal.foreground": "#333333",
    "terminalCursor.foreground": "#21BDFF",
    "terminal.selectionBackground": "#8ED3FF",
    "terminal.ansiBlack": "#333333",
    "terminal.ansiRed": "#D0372D",
    "terminal.ansiGreen": "#008000",
    "terminal.ansiYellow": "#BB6600",
    "terminal.ansiBlue": "#0000FF",
    "terminal.ansiMagenta": "#BA36A5",
    "terminal.ansiCyan": "#007777",
    "terminal.ansiWhite": "#E5E5E5",
    "terminal.ansiBrightBlack": "#7F7F7F",
    "terminal.ansiBrightRed": "#CC0000",
    "terminal.ansiBrightGreen": "#158A15",
    "terminal.ansiBrightYellow": "#9A6F00",
    "terminal.ansiBrightBlue": "#006FE0",
    "terminal.ansiBrightMagenta": "#6434A3",
    "terminal.ansiBrightCyan": "#006699",
    "terminal.ansiBrightWhite": "#F2F2F2"
  },
  "tokenColors": [
    {
      "name": "Comment (font-lock-comment-face)",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8D8D84", "fontStyle": "italic" }
    },
    {
      "name": "Documentation (font-lock-doc-face)",
      "scope": ["comment.block.documentation", "string.quoted.docstring", "comment.block.javadoc"],
      "settings": { "foreground": "#036A07", "fontStyle": "" }
    },
    {
      "name": "String (font-lock-string-face)",
      "scope": ["string", "punctuation.definition.string", "string.regexp"],
      "settings": { "foreground": "#008000" }
    },
    {
      "name": "Escape (escape-glyph)",
      "scope": ["constant.character.escape", "constant.other.placeholder"],
      "settings": { "foreground": "#008ED1" }
    },
    {
      "name": "Keyword (font-lock-keyword-face)",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.word",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#0000FF" }
    },
    {
      "name": "Operators stay plain, as in Emacs",
      "scope": ["keyword.operator", "punctuation"],
      "settings": { "foreground": "#333333" }
    },
    {
      "name": "Function definition (font-lock-function-name-face)",
      "scope": ["entity.name.function", "meta.definition.method entity.name.function"],
      "settings": { "foreground": "#006699" }
    },
    {
      "name": "Function calls stay plain: Emacs colours only the definition",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "meta.method-call entity.name.function"
      ],
      "settings": { "foreground": "#333333" }
    },
    {
      "name": "Builtin (font-lock-builtin-face)",
      "scope": ["support.function", "support.function.builtin", "variable.language", "support.variable"],
      "settings": { "foreground": "#006FE0" }
    },
    {
      "name": "Type (font-lock-type-face)",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": { "foreground": "#6434A3" }
    },
    {
      "name": "Variable definition (font-lock-variable-name-face)",
      "scope": ["entity.name.variable", "variable.parameter", "variable.other.definition", "support.type.property-name"],
      "settings": { "foreground": "#BA36A5" }
    },
    {
      "name": "Constant (font-lock-constant-face)",
      "scope": ["constant.language", "constant.other", "support.constant", "variable.other.constant", "variable.other.enummember"],
      "settings": { "foreground": "#D0372D" }
    },
    {
      "name": "Preprocessor and decorators (font-lock-preprocessor-face)",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": { "foreground": "#808080" }
    },
    {
      "name": "Tag (xml-tag)",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#AE1B9A" }
    },
    {
      "name": "Attribute (xml-attribute)",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#F36335" }
    },
    {
      "name": "Invalid (font-lock-warning-face)",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FF0000", "fontStyle": "bold" }
    },
    {
      "name": "Heading (org-level-2)",
      "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"],
      "settings": { "foreground": "#123555", "fontStyle": "bold" }
    },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": "markup.strikethrough", "settings": { "fontStyle": "strikethrough" } },
    {
      "name": "Link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#006DAF", "fontStyle": "underline" }
    },
    {
      "name": "Inline code (code-inline)",
      "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw"],
      "settings": { "foreground": "#006400" }
    },
    {
      "name": "Quote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#7F7F7F", "fontStyle": "italic" }
    },
    { "scope": "markup.inserted", "settings": { "foreground": "#008000" } },
    { "scope": "markup.deleted", "settings": { "foreground": "#D0372D" } },
    { "scope": "markup.changed", "settings": { "foreground": "#0000FF" } }
  ],
  "semanticTokenColors": {
    "variable.declaration": "#BA36A5",
    "parameter.declaration": "#BA36A5",
    "property.declaration": "#BA36A5",
    "function.declaration": "#006699",
    "method.declaration": "#006699",
    "function": "#333333",
    "method": "#333333",
    "function.defaultLibrary": "#006FE0",
    "variable.readonly": "#D0372D",
    "enumMember": "#D0372D",
    "type": "#6434A3",
    "class": "#6434A3",
    "namespace": "#333333",
    "selfParameter": "#006FE0"
  }
}
